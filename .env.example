# Copy this file to .env and change the passwords. Never commit .env.

POSTGRES_USER=comps_admin
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=comps_engine
POSTGRES_PORT=5432

MONGO_USER=comps_admin
MONGO_PASSWORD=change_me_mongo
MONGO_PORT=27017
MONGO_DB=comps_engine

# Used by the Python scripts in ingest/ (host is localhost because Docker publishes the ports)
DATABASE_URL=postgresql://comps_admin:change_me_postgres@localhost:5432/comps_engine
MONGO_URL=mongodb://comps_admin:change_me_mongo@localhost:27017/?authSource=admin
