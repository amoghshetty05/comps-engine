# Copy this file to web/.env.local and fill it in. Never commit .env.local.
# Use the same values as the root .env (note the non-default ports).
DATABASE_URL=postgresql://comps_admin:CHANGE_ME@localhost:5433/comps_engine
MONGO_URL=mongodb://comps_admin:CHANGE_ME@localhost:27018/?authSource=admin
MONGO_DB=comps_engine

# Secret used to sign login tokens. Any long random string, e.g. from:
#   python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
